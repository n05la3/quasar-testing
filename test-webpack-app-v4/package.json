{
  "name": "test-webpack-app-v4",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Quasar App",
  "author": "Paolo Caleffi <p.caleffi@dreamonkey.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:jest": "pnpm --dir ../packages/unit-jest build:local && pnpm add -D ../packages/unit-jest",
    "sync:cypress": "pnpm --dir ../packages/e2e-cypress build:local && pnpm add -D ../packages/e2e-cypress",
    "sync:all": "pnpm sync:jest && pnpm sync:cypress",
    "invoke:jest": "quasar ext invoke @quasar/testing-unit-jest && pnpm format",
    "invoke:cypress": "quasar ext invoke @quasar/testing-e2e-cypress && pnpm format",
    "invoke:all": "pnpm invoke:jest && pnpm invoke:cypress",
    "sync:invoke:jest": "pnpm sync:jest && pnpm invoke:jest",
    "sync:invoke:cypress": "pnpm sync:cypress && pnpm invoke:cypress",
    "sync:invoke:all": "pnpm sync:invoke:jest && pnpm sync:invoke:cypress",
    "test:jest": "pnpm test:unit:ci",
    "test:cypress": "pnpm test:e2e:ci && pnpm test:component:ci",
    "test:all": "pnpm test:jest && pnpm test:cypress",
    "sync:invoke:test:jest": "pnpm sync:invoke:jest && pnpm test:jest",
    "sync:invoke:test:cypress": "pnpm sync:invoke:cypress && pnpm test:cypress",
    "sync:invoke:test:all": "pnpm sync:invoke:test:jest && pnpm sync:invoke:test:cypress",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\" --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "test:e2e": "cross-env NODE_ENV=test TS_NODE_PROJECT=test/cypress/tsconfig.json start-test \"quasar dev\" http-get://127.0.0.1:8080 \"cypress open --e2e\"",
    "test:e2e:ci": "cross-env NODE_ENV=test TS_NODE_PROJECT=test/cypress/tsconfig.json start-test \"quasar dev\" http-get://127.0.0.1:8080 \"cypress run --e2e\"",
    "test:component": "cross-env NODE_ENV=test TS_NODE_PROJECT=test/cypress/tsconfig.json cypress open --component",
    "test:component:ci": "cross-env NODE_ENV=test TS_NODE_PROJECT=test/cypress/tsconfig.json cypress run --component",
    "test:unit:ui": "majestic",
    "test:unit": "jest",
    "test:unit:ci": "jest --ci",
    "test:unit:coverage": "jest --coverage",
    "test:unit:watch": "jest --watch",
    "test:unit:watchAll": "jest --watchAll",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.6",
    "axios": "^1.2.1",
    "core-js": "^3.32.2",
    "pinia": "^3.0.1",
    "quasar": "^2.16.4",
    "vue": "^3.4.29",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@jest/globals": "^29.7.0",
    "@quasar/app-webpack": "^4.1.0",
    "@quasar/quasar-app-extension-testing-e2e-cypress": "file:../packages/e2e-cypress",
    "@quasar/quasar-app-extension-testing-unit-jest": "file:../packages/unit-jest",
    "@types/node": "^20.5.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "autoprefixer": "^10.4.2",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "cypress": "^15.20.0",
    "eslint": "^9.14.0",
    "eslint-plugin-cypress": "^4.3.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-vue": "^9.30.0",
    "eslint-webpack-plugin": "^4.2.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "prettier": "^3.3.3",
    "start-server-and-test": "^2.1.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.4.2",
    "typescript": "~5.6.0",
    "majestic": "^1.7.0"
  },
  "browserslist": [
    "last 10 Chrome versions",
    "last 10 Firefox versions",
    "last 4 Edge versions",
    "last 7 Safari versions",
    "last 8 Android versions",
    "last 8 ChromeAndroid versions",
    "last 8 FirefoxAndroid versions",
    "last 10 iOS versions",
    "last 5 Opera versions"
  ],
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4"
  }
}
