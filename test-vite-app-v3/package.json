{
  "name": "test-vite-app-v3",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Quasar App",
  "author": "Paolo Caleffi <p.caleffi@dreamonkey.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "sync:vitest": "pnpm --dir ../packages/unit-vitest build:local && pnpm add -D ../packages/unit-vitest",
    "sync:cypress": "pnpm --dir ../packages/e2e-cypress build:local && pnpm add -D ../packages/e2e-cypress",
    "sync:all": "pnpm sync:vitest && pnpm sync:cypress",
    "invoke:vitest": "quasar ext invoke @quasar/testing-unit-vitest && pnpm format",
    "invoke:cypress": "quasar ext invoke @quasar/testing-e2e-cypress && pnpm format",
    "invoke:all": "pnpm invoke:vitest && pnpm invoke:cypress",
    "sync:invoke:vitest": "pnpm sync:vitest && pnpm invoke:vitest",
    "sync:invoke:cypress": "pnpm sync:cypress && pnpm invoke:cypress",
    "sync:invoke:all": "pnpm sync:invoke:vitest && pnpm sync:invoke:cypress",
    "test:vitest": "pnpm test:unit:ci",
    "test:cypress": "pnpm test:e2e:ci && pnpm test:component:ci",
    "test:all": "pnpm test:vitest && pnpm test:cypress",
    "test:unit:ci": "vitest run",
    "test:e2e:ci": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:8080 \"cypress run --e2e\"",
    "test:component:ci": "cross-env NODE_ENV=test cypress run --component",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "test:unit": "vitest",
    "test:e2e": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:8080 \"cypress open --e2e\"",
    "test:component": "cross-env NODE_ENV=test cypress open --component",
    "test:unit:ui": "vitest --ui"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.3",
    "axios": "^1.7.9",
    "pinia": "^4.0.2",
    "quasar": "^2.24.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.7",
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^3.5.0",
    "@quasar/quasar-app-extension-testing-e2e-cypress": "file:../packages/e2e-cypress",
    "@quasar/quasar-app-extension-testing-unit-vitest": "file:../packages/unit-vitest",
    "@quasar/vite-plugin": "^2.0.0",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/ui": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "cypress": "^15.20.0",
    "eslint": "^10.8.0",
    "eslint-plugin-cypress": "^4.3.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "happy-dom": "^17.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "start-server-and-test": "^2.1.2",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}